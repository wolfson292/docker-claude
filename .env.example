# Copy to .env and `chmod 600 .env`. Never commit .env.

# --- Container -------------------------------------------------------------
RC_NAME=claude-rc                 # name shown in the Claude app
RC_PERMISSION_MODE=default        # default | acceptEdits | auto | plan | dontAsk | bypassPermissions
RC_SPAWN=same-dir                 # same-dir | worktree | session
PUID=1000                         # owner of mounted files
PGID=1000
INSTALL_GHIDRA=true               # build-time; false skips Ghidra/GhidraMCP/JDK
TZ=UTC
# DATA_DIR=./data
# COMPOSE_FILE=docker-compose.yml:docker-compose.samba.yml

# --- SMB shares (only with docker-compose.samba.yml) -----------------------
# SMB1_NAME=ha-home
# SMB1_SHARE=//192.0.2.10/config
# SMB1_USERNAME=
# SMB1_PASSWORD=
# SMB2_NAME=ha-cabin
# SMB2_SHARE=//192.0.2.20/config
# SMB2_USERNAME=
# SMB2_PASSWORD=

# --- MCP server settings (servers with unset variables are skipped) --------
# Home Assistant (ha-mcp), two instances
HA1_URL=
HA1_TOKEN=
HA2_URL=
HA2_TOKEN=

# Portainer
PORTAINER_URL=
PORTAINER_API_KEY=

# UniFi Network / Protect (local controller account)
UNIFI_HOST=
UNIFI_USERNAME=
UNIFI_PASSWORD=
UNIFI_SITE=default
